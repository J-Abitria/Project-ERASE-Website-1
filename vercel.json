{
  "version": 2,
  "git": {
    "deploymentEnabled": false
  },
  "builds": [
    {
      "src": "code/ERASEwebsite/mysite/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "code/ERASEwebsite/mysite/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-completed-events",
      "schedule": "0 6 * * *"
    }
  ]
}
